DATABASE_URL=postgresql://yuashie:CHANGE_ME@127.0.0.1:5432/yuashie
PORT=3000
NODE_ENV=production
SITE_ORIGIN=https://yuashie.cn
# Required in production: generate a private random secret (at least 32 characters).
CSRF_SECRET=

USER_CONTENT_DIR=/var/www/yuashie-app/user-content

# Minecraft whitelist bridge authentication
# YuashieWhitelistBridge can reuse the existing RCON password as its outbound
# HTTPS bearer token, so no public RCON port is required. For a dedicated
# secret, set MC_BRIDGE_TOKEN here and token-source: config in the plugin.
MC_BRIDGE_TOKEN=
MC_RCON_PASSWORD=CHANGE_ME

# Unified Yuashie / AstrAcct accounts. Leave OAuth providers unset until applications are approved.
# Captcha 2.0 is human verification only; no SMS or email delivery is included.
# Set enabled=true when rolling out CAPTCHA; incomplete configuration then fails closed.
ALIYUN_CAPTCHA_ENABLED=false
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_PREFIX=
ALIYUN_CAPTCHA_REGION=cn
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# Optional temporary credentials:
ALIBABA_CLOUD_SECURITY_TOKEN=
OAUTH_QQ_CLIENT_ID=
OAUTH_QQ_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Preferred on ECS: a role-bound Credentials SDK client with IMDSv2, no long-lived AccessKey.
ALIBABA_CLOUD_CREDENTIALS_TYPE=ecs_ram_role
ALIBABA_CLOUD_ECS_METADATA=YuashieAuthRole
# Enable after verifying the role and sender in the deployment environment.
ALIYUN_MAIL_ENABLED=false
ALIYUN_MAIL_FROM=verify@auth.yuashie.com

# PNVS / 号码认证服务 -> 短信认证 (not the domestic SMS SendSms product).
# Use its system-provided sign/template, with code and min variables.
# Grant the ECS role dypns:SendSmsVerifyCode and dypns:CheckSmsVerifyCode.
# CAPTCHA 2.0 is a separate human-verification gate.
ALIYUN_PNVS_ENABLED=false
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=100001
ALIYUN_PNVS_BIND_TEMPLATE_CODE=100004
ALIYUN_PNVS_VERIFY_TEMPLATE_CODE=100005
# Optional; send and verify use the same scheme. Empty uses the default scheme.
ALIYUN_PNVS_SCHEME_NAME=
